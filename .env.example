# NewsAgg 环境变量示例
#
# 用法：复制为 `.env` 并填入真实值。
#   cp .env.example .env
#
# `.env` **绝不入库**（.gitignore 已排除，ADR-0015/0018）；本示例文件入库，
# 用来记录"这套系统需要哪些凭证"。
#
# 读取方式：`run_all.sh` 在启动时 `set -a; source .env; set +a`。
# 之所以要这样，是因为**定时任务由调度器直接拉起、不经过交互式 shell**，
# 不能依赖你手动 export。手动跑脚本时同样生效。
#
# 全部留空也能跑：缺 key 的后果是明确的降级，不是崩溃（见每条说明）。

# ══ 写作模型（wewrite 混合路由，ADR-0006 模型分层）══════════════════
# 分拣用便宜快模型（由编排 agent 承担），写作用强模型（由这里指定）。
# 不填 WEWRITE_WRITER_API_KEY 时，`wewrite llm-write` 返回**退出码 3**，
# 这是设计上的降级路径：改由编排 agent 自写初稿（run_all.sh 已处理）。
WEWRITE_WRITER_API_KEY=
WEWRITE_WRITER_PROVIDER=deepseek
WEWRITE_WRITER_BASE_URL=https://api.deepseek.com
WEWRITE_WRITER_MODEL=deepseek-chat
WEWRITE_WRITER_TEMPERATURE=1.0
WEWRITE_WRITER_MAX_TOKENS=4000

# ══ 配图模型（可选）════════════════════════════════════════════════
# 封面默认走**模板拼图**（make_cover.py，本地 Pillow，不联网、不花钱、不涉版权）。
# 只有当你想让封面用 AI 生图时才需要下面这些；ADR-0013 明确**不使用新闻原图**。
WEWRITE_IMAGE_API_KEY=
WEWRITE_IMAGE_PROVIDER=
WEWRITE_IMAGE_MODEL=

# ══ 本项目的运行时开关 ═════════════════════════════════════════════
# 热榜服务地址（DailyHotApi）。默认 http://127.0.0.1:6688
# 服务器上若把它跑在别的端口，在这里改。
NEWSAGG_HOT_BASE=http://127.0.0.1:6688

# ══ 代理（ADR-0022，仅服务器需要）═════════════════════════════════
# 头条与国内源**必须直连**：账号在国内住宅网络注册，发布流量若从境外出口
# 发出，等于白送一个"账号共享/被盗"的封号条件。
# 机场订阅链接只在这里保存，分流规则入库（见 docs/adr/0022-*.md）。
# 本地用 Clash Verge 时无需填写。
CLASH_SUBSCRIPTION_URL=
