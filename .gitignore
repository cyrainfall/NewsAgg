# ── 运行时状态与工具缓存（不入库）──
.uv-cache/
.uv-tools/
.uv-bin/
.npm-cache/
.venv/
node_modules/

# ── 凭证（ADR-0015 / 0018 / 0022：绝不入库）──
.env
.wewrite/config.yaml
.wewrite/browser-profile/
.toutiao-ops/

# ── 参考仓库（ADR-0012：本地可读，不入库，因含 GB 级依赖目录）──
# 例外：toutiao-ops 源码需入仓并打补丁（ADR-0024 要求 fork 最小改动）。
# 其依赖目录仍排除（21MB 全是 node_modules，源码仅约 160KB）。
reference/*
!reference/toutiao-ops/

# ── 已 vendored 的外部仓库的依赖目录 ──
reference/Agent-Reach/.venv/
reference/toutiao-ops/cli/node_modules/
reference/DailyHotApi/node_modules/

# ── macOS ──
.DS_Store

# ── 输出产物的图片（体积大且可从源重建）──
outputs/**/*.png
outputs/**/*.jpg

# ── 本地运行状态（ADR-0028：HOME 重定向的产物）──
.home/

# ── 运行时状态（ADR-0027 双环境：本地与服务器各自持有，不入库以免冲突）──
# 注意与 .home/ 的区别：.home 是 HOME 重定向产物（含头条会话，属凭证）；
# .newsagg 是每日运行的中间产物（候选、分拣输入、锁、熔断、发布台账）。
# 冻结成结论的产物应写入 reports/ 与 knowledge/（那两者入库）。
.newsagg/
